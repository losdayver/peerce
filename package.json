{
  "name": "peerce",
  "version": "0.2.0-alpha.3",
  "description": "Simple UDP data transfer package based on NAT hole punching",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && jest",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build",
    "lint": "eslint src",
    "prepublishOnly": "npm run lint && npm test"
  },
  "main": "./dist/exports/main.js",
  "types": "./types/exports/main.d.ts",
  "exports": {
    ".": {
      "types": "./types/exports/main.d.ts",
      "require": "./dist/exports/main.js",
      "import": "./dist/exports/main.js",
      "default": "./dist/exports/main.js"
    }
  },
  "files": [
    "dist/exports",
    "dist/simple",
    "dist/transport",
    "dist/utils",
    "types/exports",
    "types/simple",
    "types/transport",
    "types/utils",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "peer-to-peer",
    "udp",
    "nat-traversal",
    "file-transfer",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/losdayver/p2p_messenger.git"
  },
  "bugs": {
    "url": "https://github.com/losdayver/p2p_messenger/issues"
  },
  "homepage": "https://github.com/losdayver/p2p_messenger#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "bin": {
    "peerce-exchange": "./dist/simple/bin/peer.js",
    "peerce-start-relay": "./dist/simple/bin/relay.js",
    "peerce-keygen": "./dist/simple/bin/keygen.js"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^10.2.1",
    "jest": "^30.3.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "state-shifter": "^1.0.0"
  }
}
